# =============================================================================
# FabGuard Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your credentials:
# cp .env.example .env
# =============================================================================

# ── IBM Bob / watsonx.ai (PRIMARY — BOBathon SaaS Integration) ───────────────
# Get your API key: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=20260915-1650-5679-61fd-a8533eb2eafb
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL=ibm/granite-3-8b-instruct
LLM_PROVIDER=ibm_bob

# ── Fallback 1: Groq (Ultra-fast cloud LLM) ──────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Fallback 2: Google Gemini ────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Model Hyperparameters ───────────────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512

# ── Server Ports ────────────────────────────────────────────────────────────
BACKEND_PORT=8005
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8005
