# ============================================================
# Bob Fab Copilot — Environment Configuration
# Copy this file to .env and fill in your actual API key.
# NEVER commit .env to git.
# ============================================================

# --- LLM Provider (uncomment ONE block) ---

# Option A: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Option B: Groq
# GROQ_API_KEY=gsk_...
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Option D: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-20241022

# --- Copilot behaviour ---
# Temperature for explanation/recommendation generation (0.0 = deterministic)
LLM_TEMPERATURE=0.3
# Max tokens for explanation responses
LLM_MAX_TOKENS=512

