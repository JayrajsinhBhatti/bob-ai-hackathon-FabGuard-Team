# ============================================================
# Bob Fab Copilot — Environment Configuration
# Copy this file to .env and fill in your actual API key.
# NEVER commit .env to git.
# ============================================================

# --- LLM Provider (uncomment ONE block) ---

# Option 1: IBM Bob / watsonx.ai Granite 3.0 (PRIMARY for BOBathon)
# WATSONX_API_KEY=your_ibm_cloud_api_key_here
# WATSONX_PROJECT_ID=20260915-1650-5679-61fd-a8533eb2eafb
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL=ibm/granite-3-8b-instruct
# LLM_PROVIDER=ibm_bob

# Option 2: Groq (Ultra-fast fallback)
# GROQ_API_KEY=gsk_...
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Option 4: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# --- Copilot behaviour ---
# Temperature for explanation/recommendation generation (0.0 = deterministic)
LLM_TEMPERATURE=0.3
# Max tokens for explanation responses
LLM_MAX_TOKENS=512

