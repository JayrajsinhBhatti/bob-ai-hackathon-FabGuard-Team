# ============================================================
# Bob Fab Copilot — Environment Configuration
# Copy this file to .env and fill in your actual API key.
# NEVER commit .env to git.
# ============================================================

# --- LLM Provider (uncomment ONE block) ---

# Option A: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-2.5-flash

# Option B: Groq
# GROQ_API_KEY=gsk_...
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# Option C: OpenAI
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# Option D: Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-3-5-haiku-20241022

# Option E: IBM watsonx.ai (Granite 3.0)
# WATSONX_API_KEY=your_ibm_cloud_api_key_here
# WATSONX_PROJECT_ID=your_watsonx_project_id_here
# WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_MODEL=ibm/granite-3-8b-instruct
# LLM_PROVIDER=watsonx
# LLM_MODEL=ibm/granite-3-8b-instruct

# --- Copilot behaviour ---
# Temperature for explanation/recommendation generation (0.0 = deterministic)
LLM_TEMPERATURE=0.3
# Max tokens for explanation responses
LLM_MAX_TOKENS=512

